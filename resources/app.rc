// Windows resource script: application icon + version info
#include <winver.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "moviecap"
      VALUE "FileDescription", "AI Movie Shorts - AI-narrated movie recaps"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "AI Movie Shorts (Windows)"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
